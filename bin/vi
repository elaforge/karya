#!/usr/bin/env zsh
# Wrapper around vim for editing ky files.
#
# This could be in the global or local .vimrc filetype.vim, but since
# it calls send on save, it only makes sense to run when run from this
# directory.

# TODO bring this back if I want to re-use vi name.
# Find the next vi in PATH to avoid recursion.
# next=($(whence -a $(basename $0)))
# exec $next[2] -c "source ky.vim" "$@"

exec vim --cmd \
    "au BufRead,BufNewFile *.ky set filetype=ky | source ${0:A:h:h}/ky.vim" \
    "$@"
